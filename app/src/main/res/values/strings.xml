    <string name="first_run_title">Welcome to RadioWave</string>
    <string name="first_run_body">Quick setup notes:\n- Android Auto can prefer efficient streams; you can change this in settings.\n- Battery optimization should be disabled for the app.\n- Release notes and “What’s new” are available in settings.</string>
    <string name="first_run_confirm">Understood</string>
    <string name="onboarding_step_welcome_title">Ad-free radio, built for daily use</string>
    <string name="onboarding_step_welcome_body">RadioWave gives you fast internet radio without ads, accounts, or hidden tracking.</string>
    <string name="onboarding_step_search_title">Find stations quickly</string>
    <string name="onboarding_step_search_body">Use Search to browse stations, filter by country or genre, and save your favorites for later.</string>
    <string name="onboarding_step_player_title">Playback works beyond the app</string>
    <string name="onboarding_step_player_body">Use the mini player, fullscreen player, notification controls, and lockscreen controls to keep listening smoothly.</string>
    <string name="onboarding_step_auto_title">Android Auto stays under your control</string>
    <string name="onboarding_step_auto_body">RadioWave supports Android Auto, previous/next station navigation, and an optional efficient in-car quality limit in settings.</string>
    <string name="onboarding_step_updates_title">Updates and release notes are built in</string>
    <string name="onboarding_step_updates_body">You can open release notes, view “What’s new”, and restart this introduction anytime from settings.</string>
